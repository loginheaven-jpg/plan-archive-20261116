# Server-only. Never commit real values.
# Manus provides DATABASE_URL to the development and published runtime.
# For independent hosting, supply your own MySQL URL with required TLS options.
DATABASE_URL=
# Existing saint.yebom.org SESSION_SECRET; minimum 32 characters, same server-side value.
YEBOM_SSO_SECRET=
# Explicit trusted calendar admin user IDs. Calendar grants are independent of finance roles.
YEBOM_CALENDAR_ADMIN_IDS=
# Fixed production origin, only after the domain and saint redirect allowlist are configured.
APP_PUBLIC_ORIGIN=https://plan.yebom.org
# Optional exact additional frontend origins if documented by auth implementation.
APP_ALLOWED_ORIGINS=
