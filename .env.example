# Server-only. Never commit real values.
# Manus provides DATABASE_URL to development and the published runtime.
# For independent hosting, supply your own MySQL URL with required TLS options.
DATABASE_URL=
# Fixed HTTPS application origin; ordinary calendars are readable without login.
APP_PUBLIC_ORIGIN=https://plan.yebom.org
# Explicit trusted calendar admin Saint user IDs; local grants are independent of finance roles.
YEBOM_CALENDAR_ADMIN_IDS=
# Optional exact additional frontend origins, if explicitly authorized.
APP_ALLOWED_ORIGINS=
# Active authentication calls the fixed official Saint session API server-to-server.
# No local YEBOM_SSO_SECRET or copied Saint SESSION_SECRET is required.
# Saint must issue its shared cookie with COOKIE_DOMAIN=.yebom.org.
